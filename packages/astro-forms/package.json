{
  "name": "@librepublish/astro-forms",
  "version": "0.1.0",
  "description": "LibrePublish CMS forms on an Astro site: <Form> with Turnstile, posting straight to the CMS, and form emails in the site's design",
  "license": "FSL-1.1-MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Martin-Business-Consultants/cms-astro",
    "directory": "packages/astro-forms"
  },
  "keywords": [
    "astro-integration",
    "withastro",
    "cms",
    "librepublish",
    "forms",
    "turnstile"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    },
    "./emails": {
      "types": "./dist/emails.d.ts",
      "default": "./dist/emails.js"
    },
    "./components/*": "./src/components/*"
  },
  "files": [
    "dist",
    "src/components"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "@librepublish/astro": "^0.1.0"
  },
  "devDependencies": {
    "astro": "^7.3.6",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0",
    "@librepublish/astro": "*"
  }
}
