{
  "name": "@librepublish/astro",
  "version": "0.1.0",
  "description": "Build an Astro site on LibrePublish CMS: content loaders, types, sitemap, redirects, cache purges and build checks",
  "license": "FSL-1.1-MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Martin-Business-Consultants/cms-astro",
    "directory": "packages/astro"
  },
  "keywords": [
    "astro-integration",
    "withastro",
    "cms",
    "librepublish",
    "cloudflare"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./loaders": {
      "types": "./dist/loaders.d.ts",
      "default": "./dist/loaders.js"
    },
    "./live": {
      "types": "./dist/live.d.ts",
      "default": "./dist/live.js"
    },
    "./runtime/*": {
      "types": "./dist/runtime/*.d.ts",
      "default": "./dist/runtime/*.js"
    },
    "./components/*": "./src/components/*"
  },
  "files": [
    "dist",
    "src/components"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/"
  },
  "peerDependencies": {
    "astro": "^7.0.0"
  },
  "devDependencies": {
    "astro": "^7.3.6",
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  }
}
