---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import type { CmsEntry } from "@librepublish/astro/client";

export async function getStaticPaths() {
  return (await getCollection("posts")).map((post) => ({ params: { slug: post.id }, props: { post: post.data as unknown as CmsEntry } }));
}
const { post } = Astro.props;
---
<Base record={post}>
  <h1>{post.title}</h1>
  <article set:text={post.body_markdown ?? ""} />
</Base>
